      "data": "stories/oahu-energy/layers/solar.geojson",
      "icon": "stories/oahu-energy/icons/solar.png",
      "render": "fill",
      "fill": {
        "type": "buildout",
        "budget": {
          "terms": [
            {
              "source": "generation",
