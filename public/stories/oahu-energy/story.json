            {
              "source": "curtailment",
              "technologies": [
                "PV"
              ]
            }
          ]
        },
        "sortBy": [
          {
            "property": "cf_1",
            "direction": "desc"
          }
        ],
        "cost": {
          "properties": [
            "cf_1",
