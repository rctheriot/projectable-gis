      "icon": "stories/oahu-energy/icons/parks.png",
      "render": "fill",
      "fill": {
        "type": "static"
      },
      "color": "#994E95",
      "outlineColor": "white",
      "lineWidth": 1
    },
    {
      "id": "government",
      "name": "Government Lands",
      "description": "Federal, State, County and DHHL land, including the large military holdings in central Oahu.",
      "data": "stories/oahu-energy/layers/government.geojson",
      "icon": "stories/oahu-energy/icons/government.png",
      "render": "fill",
      "fill": {
        "type": "static"
      },
      "color": "#CC503E",
      "outlineColor": "white",
      "lineWidth": 1
    },
    {
      "id": "solar",
