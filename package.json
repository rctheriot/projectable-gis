{
  "name": "projectable-pucks",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Projected GIS storytelling table with tangible puck controls",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare-story": "node scripts/build-story.mjs",
    "markers": "node scripts/generate-markers.mjs"
  },
  "dependencies": {
    "d3-dsv": "^3.0.1",
    "js-aruco2": "^2.0.0",
    "maplibre-gl": "^5.9.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@maplibre/maplibre-gl-style-spec": "^26.4.4",
    "@types/d3-dsv": "^3.0.7",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "geotiff": "^3.0.5",
    "sharp": "^0.34.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.19"
  }
}
